{
  "name": "@itsy/corgi",
  "version": "1.2.0",
  "description": "tiny composable typed fetch — one-off or client; cancel-previous, retry, timeout, and schema-validated transforms",
  "keywords": [
    "abort",
    "client",
    "composable",
    "fetch",
    "http",
    "isomorphic",
    "retry",
    "timeout",
    "tiny",
    "typescript"
  ],
  "license": "MIT",
  "author": "Dave Honneffer <pearofducks@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyjs/corgi.git"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js"
    },
    "./abort-previous": {
      "types": "./dist/abort-previous.d.ts",
      "import": "./dist/abort-previous.js"
    },
    "./timeout": {
      "types": "./dist/timeout.d.ts",
      "import": "./dist/timeout.js"
    },
    "./timeout-modern": {
      "types": "./dist/timeout-modern.d.ts",
      "import": "./dist/timeout-modern.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./chonk": {
      "types": "./dist/chonk.d.ts",
      "import": "./dist/chonk.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test test/*.test.ts",
    "test:build": "pnpm build && pnpm test",
    "size": "size-limit",
    "size:check": "export-size .",
    "check": "oxfmt --check && oxlint && tsc --noEmit && node --test test/*.test.ts",
    "preversion": "npm run check",
    "postversion": "git push --follow-tags",
    "docs:dev": "pnpm build && vitepress dev docs",
    "docs:build": "pnpm build && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@shikijs/vitepress-twoslash": "4.4.2",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.2.0",
    "export-size": "^0.8.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@11.9.0"
}
